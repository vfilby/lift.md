{
  "name": "lmwf-validator-e2e",
  "version": "1.0.0",
  "description": "Browser-driven E2E suite for the LMWF validator + website. See spec/services/validator-e2e.md.",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
