{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true
  },
  // Only the table schema module is shared with the CDK app. The rest of
  // src/ is ESM (import.meta) and is type-checked by the validator's own
  // tsconfig, not under this commonjs config.
  "include": ["*.ts", "../src/infra/tables.ts"],
  "exclude": ["node_modules", "dist"]
}
