---
import Base from '../layouts/Base.astro';

// Marketing landing. No format/validator content — that lives at /format.
// (A "See it in action" screenshot gallery will return once real app
// captures exist — intentionally omitted rather than shown as placeholders.)
---

<Base title="lift.md" home>
  <section class="hero">
    <div class="hero-logo-wrap" aria-hidden="true">
      <img class="hero-logo hero-logo-ink" src="/brand/logos/lockup-liftmd-ink.svg" alt="" width="689" height="260" />
      <img class="hero-logo hero-logo-white" src="/brand/logos/lockup-liftmd-white.svg" alt="" width="689" height="260" />
    </div>
    <p class="hero-sub">
      Track your workouts with simple, markdown-based workout plans — write them
      yourself or let an agent draft them.
    </p>
    <div class="hero-cta">
      <a class="lm-btn lm-btn-primary" href="https://testflight.apple.com/join/u8EJFzYu" rel="external noopener">
        Join the iOS beta
      </a>
      <a class="lm-btn lm-btn-secondary" href="/format">Explore the format →</a>
    </div>
    <p class="hero-cta-note">iOS only — public beta on TestFlight, not yet on the App Store.</p>
  </section>

  <section class="pillars" aria-label="Why lift.md">
    <div class="pillar">
      <h2>Own Your Data</h2>
      <p>Bring your own data in, and export out just as easily. No lock-in.</p>
    </div>
    <div class="pillar">
      <h2>Agent Friendly</h2>
      <p>Plans are just markdown, so any LLM can read and write them — and you can export your training data in clean, machine-readable formats.</p>
    </div>
  </section>

  <section class="closing">
    <h2>Built on an open format</h2>
    <p>
      Every workout lift.md reads is just markdown — the
      <a href="/format">lift.md format</a>. Write it by hand, generate it with
      an LLM, validate it live, and keep your programs portable forever.
    </p>
    <a class="lm-btn lm-btn-secondary" href="/format">Read the format docs →</a>
  </section>

  <style>
    /* Hero */
    .hero {
      text-align: center;
      padding: 3.5rem 0 3rem;
    }
    .hero-logo-wrap {
      display: flex;
      justify-content: center;
      margin-bottom: 2rem;
      transform-origin: center top;
      will-change: transform, opacity;
    }
    .hero-logo { height: 120px; width: auto; }

    /* Light/dark swap for the full hero lockup (it carries the wordmark). */
    .hero-logo-ink { display: block; }
    .hero-logo-white { display: none; }
    :root[data-theme='dark'] .hero-logo-ink,
    :root[data-color-scheme='dark'] .hero-logo-ink { display: none; }
    :root[data-theme='dark'] .hero-logo-white,
    :root[data-color-scheme='dark'] .hero-logo-white { display: block; }
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme='light']):not([data-color-scheme='light']) .hero-logo-ink { display: none; }
      :root:not([data-theme='light']):not([data-color-scheme='light']) .hero-logo-white { display: block; }
    }
    .hero-sub {
      color: var(--color-muted);
      font-size: var(--lm-fs-body-lg);
      max-width: 52ch;
      margin: 0 auto 1.75rem;
    }
    .hero-cta {
      display: flex;
      gap: 0.75rem;
      justify-content: center;
      flex-wrap: wrap;
    }
    .hero-cta-note {
      margin: 0.9rem 0 0;
      font-size: 0.85rem;
      color: var(--color-muted);
    }

    /* Pillars */
    .pillars {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
      margin: 1.5rem 0 3rem;
    }
    .pillar {
      border: 1px solid var(--color-border);
      border-radius: var(--lm-radius-lg);
      background: var(--color-bg-subtle);
      padding: 1.25rem;
    }
    .pillar h2 {
      border: 0;
      padding: 0;
      margin: 0 0 0.4rem;
      font-size: var(--lm-fs-h4);
      color: var(--color-accent);
    }
    .pillar p { margin: 0; font-size: 0.95rem; }

    /* Closing */
    .closing {
      border-top: 1px solid var(--color-border);
      padding-top: 2rem;
      text-align: center;
    }
    .closing h2 { border: 0; padding: 0; }
    .closing p { max-width: 52ch; margin: 0 auto 1.25rem; color: var(--color-muted); }

    @media (max-width: 640px) {
      .pillars { grid-template-columns: 1fr; }
      .hero-logo { height: 84px; }
    }
  </style>
</Base>
